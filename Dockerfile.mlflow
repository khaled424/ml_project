FROM python:3.12-slim

WORKDIR /mlflow

COPY requirements.txt ./
RUN pip install --no-cache-dir -c requirements.txt mlflow

EXPOSE 5000

CMD ["mlflow", "server", "--backend-store-uri", "sqlite:////mlflow/mlflow.db", "--artifacts-destination", "/mlflow/artifacts", "--serve-artifacts", "--host", "0.0.0.0", "--port", "5000"]
